{
  "name": "rental-crm",
  "private": true,
  "version": "0.1.0",
  "description": "Demo CRM for a fictional apartment rental agency: React, TypeScript, TanStack Router and Query.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tanstack/eslint-plugin-query": "^5.108.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0"
  }
}
